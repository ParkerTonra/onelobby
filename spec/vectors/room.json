  "seats": [
    {
      "name": "stable_across_rejoin_and_dropped_seats_reserved",
      "maxPlayers": 3,
      "ops": [
        [
          "join",
          "a",
          "player"
        ],
        [
          "join",
          "b",
          "player"
        ],
        [
          "drop",
          "a"
        ],
        [
          "join",
          "c",
          "player"
        ],
        [
          "join",
          "a",
          "player"
        ]
      ],
      "expect": [
        0,
        1,
        null,
        2,
        0
      ]
    },
    {
      "name": "takes_over_a_remembered_seat_only_when_nothing_else_is_free",
      "maxPlayers": 3,
      "ops": [
        [
          "join",
          "a",
          "player"
        ],
        [
          "join",
          "b",
          "player"
        ],
        [
          "join",
          "c",
          "player"
        ],
        [
          "drop",
          "c"
        ],
        [
          "join",
          "d",
          "player"
        ],
        [
          "join",
          "c",
          "player"
        ]
      ],
      "expect": [
        0,
        1,
        2,
        null,
        2,
        -1
      ]
    },
    {
      "name": "spectators_have_no_seat_and_no_pid_is_not_remembered",
      "maxPlayers": 2,
      "ops": [
        [
          "join",
          "s",
          "spectator"
        ],
        [
          "join",
          "",
          "player"
        ],
        [
          "drop",
          ""
        ],
        [
          "join",
          "x",
          "player"
        ]
      ],
      "expect": [
        -1,
        0,
        null,
        0
      ]
    },
    {
      "name": "player_to_spectator_and_back",
      "maxPlayers": 2,
      "ops": [
        [
          "join",
          "a",
          "player"
        ],
        [
          "join",
          "b",
          "player"
        ],
        [
          "role",
          "a",
          "spectator"
        ],
        [
          "join",
          "c",
          "player"
        ],
        [
          "role",
          "a",
          "player"
        ]
      ],
      "expect": [
        0,
        1,
        -1,
        0,
        -1
      ]
    }
  ],
  "bans": {
    "cases": [
      {
        "name": "same_id",
        "entry": {
          "id": "a1",
          "ip": "10.0.0.1"
        },
        "candidate": {
          "id": "a1",
          "ip": "10.0.0.9"
        },
        "expect": true
      },
      {
        "name": "different_ids_same_ip_are_two_players",
        "entry": {
          "id": "a1",
          "ip": "10.0.0.1"
        },
        "candidate": {
          "id": "b2",
          "ip": "10.0.0.1"
        },
        "expect": false
      },
      {
        "name": "ip_only_entry_matches_any_id",
        "entry": {
          "ip": "10.0.0.1"
        },
        "candidate": {
          "id": "b2",
          "ip": "10.0.0.1"
        },
        "expect": true
      },
      {
        "name": "candidate_without_id_matches_by_ip",
        "entry": {
          "id": "a1",
          "ip": "10.0.0.1"
        },
        "candidate": {
          "ip": "10.0.0.1"
        },
        "expect": true
      },
      {
        "name": "id_only_entry_ignores_ip",
        "entry": {
          "id": "a1"
        },
        "candidate": {
          "id": "b2",
          "ip": "10.0.0.1"
        },
        "expect": false
      },
      {
        "name": "id_only_entry_matches_id",
        "entry": {
          "id": "a1"
        },
        "candidate": {
          "id": "a1"
        },
        "expect": true
      },
      {
        "name": "no_overlap",
        "entry": {
          "id": "a1",
          "ip": "10.0.0.1"
        },
        "candidate": {
          "ip": "10.0.0.2"
        },
        "expect": false
      },
      {
        "name": "ipv4_mapped_ipv6_is_the_same_address",
        "entry": {
          "ip": "::ffff:10.0.0.1"
        },
        "candidate": {
          "ip": "10.0.0.1"
        },
        "expect": true
      },
      {
        "name": "ip_case_folds",
        "entry": {
          "ip": "FE80::1"
        },
        "candidate": {
          "ip": "fe80::1"
        },
        "expect": true
      },
      {
        "name": "empty_candidate",
        "entry": {
          "id": "a1",
          "ip": "10.0.0.1"
        },
        "candidate": {},
        "expect": false
      }
    ]
  },
  "autoStart": {
    "legend": "p = player, s = spectator; r ready, n not ready, x reconnecting, l legacy. A token is role+flag, e.g. pr, pn, px, pl, sn.",
    "cases": [
      {
        "name": "off_never",
        "rule": {
          "mode": "off",
          "autoStartPlayers": 2,
          "minPlayers": 1
