  "countdown": {
    "desc": "left = ms the host reported, rtt = the receiver's last round trip (null: none). expect = ms until the end, in the receiver's clock.",
    "cases": [
      {
        "name": "no_rtt",
        "left": 3000,
        "rtt": null,
        "expect": 3000
      },
      {
        "name": "half_rtt_off",
        "left": 3000,
        "rtt": 80,
        "expect": 2960
      },
      {
        "name": "one_way_capped",
        "left": 3000,
        "rtt": 5000,
        "expect": 1000
      },
      {
        "name": "never_negative",
        "left": 500,
        "rtt": 5000,
        "expect": 0
      },
      {
        "name": "zero_left",
        "left": 0,
        "rtt": 100,
        "expect": 0
      },
      {
