        "game.netVersion": "1",
        "game.title": null,
        "engine": null,
        "hosting.direct": true,
        "hosting.server": false,
        "hosting.lobbyServer": "",
        "hosting.directPort": 47810,
        "hosting.openPort": true,
        "hosting.nostr": true,
        "hosting.nostrRelays": ["wss://nos.lol", "wss://relay.primal.net", "wss://nostr-pub.wellorder.net", "wss://nostr.oxtr.dev", "wss://nostr.bitcoiner.social", "wss://relay.nostr.net", "wss://nostr.sathoarder.com"],
        "hosting.relayOnly": false,
        "hosting.allowedOrigins": [],
        "lobby.maxPlayers": 4,
        "lobby.listed": false,
        "lobby.approveJoins": false,
        "lobby.password": false,
        "lobby.lateJoin": true,
        "lobby.rejoin": true,
        "lobby.joinLink": false,
        "lobby.meta": {},
        "sync.mode": "raw",
