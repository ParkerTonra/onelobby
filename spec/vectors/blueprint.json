      "input": { "game": { "id": "a" }, "engine": "godot-csharp", "ui": { "kind": "generated" } },
      "expect": { "ui.kind": "generated" }
    },
    {
      "name": "diagnostics_switches",
      "input": { "game": { "id": "a" }, "diagnostics": { "reportToHost": false, "logSize": 50, "relayProbe": false, "showConnectionCheck": false } },
      "expect": { "diagnostics.reportToHost": false, "diagnostics.logSize": 50, "diagnostics.relayProbe": false, "diagnostics.showConnectionCheck": false }
