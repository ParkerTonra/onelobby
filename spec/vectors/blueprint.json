    {"name": "room_late_join_conflict", "input": {"game": {"id": "a"}, "lobby": {"lateJoin": false}, "room": {"lateJoin": "allow"}}, "error": {"path": "room.lateJoin", "rule": "late_join_conflict"}},
    {"name": "room_late_join_conflict_refuse", "input": {"game": {"id": "a"}, "lobby": {"lateJoin": true}, "room": {"lateJoin": "refuse"}}, "error": {"path": "room.lateJoin", "rule": "late_join_conflict"}},
    {"name": "room_min_exceeds_max", "input": {"game": {"id": "a"}, "lobby": {"maxPlayers": 2}, "room": {"minPlayers": 3}}, "error": {"path": "room.minPlayers", "rule": "min_exceeds_max"}},
    {"name": "room_autostart_exceeds_players", "input": {"game": {"id": "a"}, "lobby": {"maxPlayers": 4}, "room": {"autoStart": "players", "autoStartPlayers": 5}}, "error": {"path": "room.autoStartPlayers", "rule": "autostart_exceeds_players"}}
  ]
