# Copy to .env and edit. Never commit .env.
# Generate the secret with:  openssl rand -hex 32

# DNS name that points at this machine (A/AAAA record). Caddy gets a certificate for it.
LOBBY_DOMAIN=lobby.example.com

# Email for Let's Encrypt expiry notices (optional but recommended).
ACME_EMAIL=you@example.com

# Shared secret: onelobby-server signs TURN credentials with it, coturn verifies them.
TURN_SECRET=change-me-run-openssl-rand-hex-32

# Public IP of this machine, as the internet sees it. Required behind NAT or on clouds that
# give you a private address (AWS, GCP, Oracle). On a plain VPS it is the same as the NIC address.
TURN_EXTERNAL_IP=203.0.113.10

# TLS TURN port (turns:). 5349 is the standard. Use 443 only if the relay has its own IP and
# Caddy is bound to a different one (see RUN_YOUR_OWN.md, "TURN on 443").
TURN_TLS_PORT=5349

# Which games may create lobbies on this server. Comma separated ids, or * for any.
ALLOWED_GAMES=*
MAX_LOBBIES=1000

# onelobby-server image. Use a tag from the releases page for production.
ONELOBBY_IMAGE=ghcr.io/parkertonra/onelobby-server:latest

# Optional: serve a Godot web build with COOP/COEP headers from ./game-web on this name.
# Leave as is to keep it off (it then listens on localhost only).
GAME_DOMAIN=http://localhost:8081
