# Run the single-file onelobby-server binary without Docker.
# Install:
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin onelobby
#   sudo install -m 755 onelobby-server /usr/local/bin/onelobby-server
#   sudo install -m 600 -o root /dev/null /etc/onelobby.env   # then fill it in (see below)
#   sudo cp onelobby-server.service /etc/systemd/system/ && sudo systemctl enable --now onelobby-server
#
# /etc/onelobby.env (mode 600):
#   ONELOBBY_TURN_SECRET=<same value as coturn's static-auth-secret>
#   LOBBY_DOMAIN=lobby.example.com
#   ONELOBBY_ALLOWED_GAMES=*
#   ONELOBBY_MAX_LOBBIES=1000
# Caddy (or another TLS proxy) still goes in front: point it at 127.0.0.1:8080.
[Unit]
Description=OneLobby lobby and signaling server
After=network-online.target
Wants=network-online.target

[Service]
User=onelobby
Group=onelobby
EnvironmentFile=/etc/onelobby.env
# Pre-rename installs: the old file (KEEPALIVE_* names are still read) is used if it exists.
EnvironmentFile=-/etc/keepalive.env
ExecStart=/usr/local/bin/onelobby-server \
  --listen 127.0.0.1:8080 \
  --public-url wss://${LOBBY_DOMAIN} \
  --trust-proxy \
  --turn-urls turn:${LOBBY_DOMAIN}:3478?transport=udp,turn:${LOBBY_DOMAIN}:3478?transport=tcp,turns:${LOBBY_DOMAIN}:5349?transport=tcp
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
LimitNOFILE=16384

[Install]
WantedBy=multi-user.target
