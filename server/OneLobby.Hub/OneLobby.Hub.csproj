<Project Sdk="Microsoft.NET.Sdk">
  <!-- The signaling hub: onelobby-server runs it behind Kestrel, a game hosting by IP runs it in-process
       (DirectHubHost, docs/design/direct-ip.md). netstandard2.1 so Unity and other engines can load it. -->
  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
    <RootNamespace>OneLobby.Server</RootNamespace>
    <AssemblyName>OneLobby.Hub</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Description>OneLobby signaling hub (protocol lk1): lobbies, join codes, signaling relay. Used by onelobby-server and by games hosting by IP.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
</Project>
