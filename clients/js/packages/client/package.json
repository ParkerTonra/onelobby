{
  "name": "onelobby",
  "version": "0.1.0",
  "description": "Multiplayer for browser games: host/join lobbies by short code, peer-to-peer WebRTC, lockstep sync, text and voice chat. Zero runtime dependencies; works from a plain <script> tag.",
  "keywords": [
    "multiplayer",
    "lobby",
    "webrtc",
    "p2p",
    "peer-to-peer",
    "netcode",
    "lockstep",
    "game",
    "gamedev",
    "browser-game",
    "voice-chat",
    "onelobby"
  ],
  "license": "MIT",
  "author": "Parker Tonra",
  "homepage": "https://github.com/ParkerTonra/onelobby#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ParkerTonra/onelobby.git",
    "directory": "clients/js/packages/client"
  },
  "bugs": {
    "url": "https://github.com/ParkerTonra/onelobby/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/onelobby.global.min.js",
  "jsdelivr": "./dist/onelobby.global.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./internals": {
      "types": "./dist/internals.d.ts",
      "import": "./dist/internals.js",
      "default": "./dist/internals.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./direct": {
      "types": "./dist/direct/index.d.ts",
      "import": "./dist/direct/index.js",
      "default": "./dist/direct/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "default": "./dist/ui/index.js"
    },
    "./global": "./dist/onelobby.global.js",
    "./bundle": {
      "types": "./dist/global.d.ts",
      "default": "./dist/onelobby.bundle.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/onelobby.global.js",
    "./dist/onelobby.global.min.js",
    "./dist/ui/index.js",
    "./dist/ui/element.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run build && npm test && node scripts/prepublish-check.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "node-datachannel": "^0.33.4"
  }
}
