<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
    <RootNamespace>OneLobby</RootNamespace>
    <AssemblyName>OneLobby.Core</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Engine-agnostic OneLobby client: lobbies, lockstep, voice and text chat.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OneLobby.Core.Tests" />
    <InternalsVisibleTo Include="OneLobby.Conformance" />
    <InternalsVisibleTo Include="OneLobby.Direct" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\spec\blueprint.schema.json" LogicalName="OneLobby.blueprint.schema.json" Link="blueprint.schema.json" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
</Project>
